export const chapters = [
  // =========================================================
  // 第一章：Express/Koa 框架类型安全
  // =========================================================
  {
    id: "ts3-node-express-types",
    title: "Express/Koa 框架类型安全",
    icon: "🚂",
    group: "Node.js 后端开发",
    content: `## Express/Koa 框架类型安全：构建类型安全的 Web 服务层

### 为什么 Web 框架需要类型安全？

在 Node.js 生态系统中，Express 和 Koa 是最流行的两个 Web 框架。然而，它们最初都是为原生 JavaScript 设计的，其核心 API 大量使用 \`any\` 类型或宽松的类型定义。这意味着在大型项目中，一个看似 innocuous 的拼写错误——比如把 \`req.user\` 写成 \`req.User\`——可能要等到运行时才能发现，而那时用户已经遇到了 500 错误。

类型安全在 Web 服务层的价值体现在以下几个方面：

1. **请求/响应契约保障**：确保路由处理器期望的参数结构与实际传入的数据一致
2. **中间件可组合性**：类型安全的中间件链可以追踪上下文中新增的属性
3. **错误处理一致性**：统一的错误类型让异常处理逻辑更加可预测
4. **重构安全性**：当你修改一个接口的数据结构时，TypeScript 会在编译期标记所有受影响的路由处理器
5. **IDE 智能提示**：完善的类型定义让开发者在写 \`req.\` 时就能看到所有可用属性，而不必反复查阅文档

### Express 类型系统的基础

在深入类型安全的模式之前，让我们先理解 \`@types/express\` 提供了什么。当你安装 \`@types/express\` 和 \`@types/koa\` 后，你获得了以下核心类型：

\`\`\`ts
// Express 核心类型概览
import type { Request, Response, NextFunction, RequestHandler } from 'express';

// Request<Params, ResBody, ReqBody, ReqQuery>
// 四个泛型参数分别对应：路由参数、响应体、请求体、查询参数
type TypedRequest = Request<
  { id: string },        // Params - URL 路径参数
  { name: string },      // ResBody - 响应体类型
  { email: string },     // ReqBody - 请求体类型
  { page?: string }      // ReqQuery - 查询字符串类型
>;

// Response<ResBody> - 响应体类型
type TypedResponse = Response<{ success: boolean; data: unknown }>;

// RequestHandler 是中间件和路由处理器的统一类型
type MyHandler = RequestHandler<
  { id: string },
  { success: boolean },
  { name: string },
  { page?: string }
>;
\`\`\`

然而，\`@types/express\` 的默认类型存在几个问题。首先，\`req.body\` 的类型默认是 \`any\`，这意味着即使你加了类型注解，中间件层的数据也无法在类型上传递。其次，当你通过中间件向 \`req\` 对象添加自定义属性（比如 \`req.user\`）时，Express 的默认类型系统无法追踪这些新增属性。

### 扩展 Request 类型：模块补充（Module Augmentation）

TypeScript 提供了"模块补充"（Module Augmentation）机制，允许我们扩展已有模块的类型定义。这是为 Express 添加自定义属性的标准方式：

\`\`\`ts
// 在 express 模块中补充 User 接口
declare global {
  namespace Express {
    interface Request {
      user?: {
        id: number;
        email: string;
        role: 'admin' | 'user';
      };
      requestId: string;
      startTime: number;
    }
  }
}
\`\`\`

模块补充虽然有效，但它是**全局**的——一旦声明，\`req.user\` 在所有路由处理器中都是可用的（即使某些路由并没有经过认证中间件）。这会误导开发者，让他们以为在未经认证的路由中 \`req.user\` 也存在。在实际项目中，更精细的做法是使用泛型来区分"已认证请求"和"未认证请求"。

### 类型安全的中间件设计

中间件是 Express/Koa 的核心概念。一个类型安全的中间件不仅要声明自己的输入输出类型，还要能在类型层面追踪它对上下文的修改。我们可以借鉴 Koa 的"洋葱模型"思想，设计一个类型安全的中间件组合器。

让我们思考一下：一个日志中间件会给请求添加 \`requestId\` 和 \`startTime\`；一个认证中间件会解析 JWT 并添加 \`req.user\`；一个验证中间件会校验请求体。当这些中间件被组合在一起时，后续的处理器应该能够访问到前面所有中间件添加的属性。

这可以通过 TypeScript 的**交叉类型（Intersection Types）**和**泛型推断**来实现。每次应用一个中间件，我们就把它新增的属性类型"叠加"到请求类型上。

### 基于 Zod 的运行时验证

仅有编译时类型是不够的——HTTP 请求来自外部世界，客户端发送的数据可能不符合任何类型约定。我们需要运行时验证来确保数据的正确性。Zod 是目前 TypeScript 生态中最流行的验证库之一，它的优势在于：你定义一次 Zod Schema，既获得了运行时验证能力，又能通过 \`z.infer<>\` 推导出 TypeScript 类型，避免了类型定义和验证逻辑的重复。

\`\`\`ts
import { z } from 'zod';

// 定义用户创建的 Schema
const CreateUserSchema = z.object({
  name: z.string().min(1).max(50),
  email: z.string().email(),
  age: z.number().int().min(0).max(150).optional(),
});

// 从 Schema 推导出 TypeScript 类型
type CreateUserInput = z.infer<typeof CreateUserSchema>;
// 等价于 { name: string; email: string; age?: number }
\`\`\`

### 类型安全的错误处理

在 Express 中，错误处理中间件有一个特殊的签名：\`(err, req, res, next) => void\`。第一个参数是错误对象。类型安全的错误处理要求我们定义统一的错误类型，区分不同类型的错误（验证错误、认证错误、授权错误、资源未找到、内部错误等），并在错误处理中间件中进行类型收窄（Type Narrowing）。

### 构建类型安全的路由

综合以上概念，我们可以构建一个类型安全的路由系统。核心思想是：

1. 每个路由都声明自己需要的中间件链
2. 路由处理器的请求类型由中间件链自动推导
3. 请求体验证使用 Zod Schema，推导类型自动流入处理器
4. 错误使用自定义错误类抛出，由统一错误处理器处理
5. 响应也有明确的类型约束

### 模拟 HTTP 服务器：为什么不实际绑定端口？

在学习类型安全模式时，我们不需要真正启动一个监听端口的 HTTP 服务器。我们可以构建一个内存中的路由注册表，模拟请求通过中间件链到达处理器的过程。这样做的好处是：代码可以在任何环境中运行（包括沙箱），而且我们可以清晰地看到数据流如何在类型系统中传递。这也是许多 Web 框架测试套件采用的做法——注入一个模拟的 Node.js \`IncomingMessage\` 或使用 supertest 之类的工具发送模拟请求。

在本章的代码示例中，我们将构建：
- 一个类型安全的中间件系统，支持属性叠加
- 基于 Zod 风格的验证中间件
- 类型区分的请求/响应类型
- 统一的错误处理机制
- 一个内存路由器，支持注册路由和模拟请求处理

通过这些代码，你将深刻理解类型系统如何为 Web 框架提供安全保障。
`,
    code: `// ============================================================
// Express/Koa 风格的类型安全 Web 框架模拟
// 不实际绑定端口，而是构建类型安全的路由/中间件链并模拟请求
// ============================================================

import { EventEmitter } from 'events';
import crypto from 'crypto';

// ------------------------------------------------------------
// 第一部分：核心类型定义
// ------------------------------------------------------------

type HttpMethod = 'GET' | 'POST' | 'PUT' | 'DELETE' | 'PATCH';

interface MockRequest<TBody = unknown, TQuery = unknown, TParams = unknown> {
  method: HttpMethod;
  path: string;
  headers: Record<string, string>;
  body: TBody;
  query: TQuery;
  params: TParams;
  [key: string]: unknown;
}

interface MockResponse {
  statusCode: number;
  headers: Record<string, string>;
  body: unknown;
  status(code: number): this;
  json(data: unknown): void;
  send(data: string): void;
}

type NextFunction = (err?: Error) => void;

type Middleware<
  TIn = MockRequest,
  TOut extends TIn = TIn
> = (
  req: TIn,
  res: MockResponse,
  next: NextFunction
) => void | TOut | Promise<void | TOut>;

type RouteHandler<TReq extends MockRequest = MockRequest> = (
  req: TReq,
  res: MockResponse
) => void | Promise<void>;

// ------------------------------------------------------------
// 第二部分：自定义错误类型
// ------------------------------------------------------------

class AppError extends Error {
  constructor(
    public readonly statusCode: number,
    public readonly code: string,
    message: string,
    public readonly details?: unknown
  ) {
    super(message);
    this.name = 'AppError';
  }
}

class ValidationError extends AppError {
  constructor(message: string, public readonly fieldErrors?: Record<string, string>) {
    super(400, 'VALIDATION_ERROR', message, fieldErrors);
    this.name = 'ValidationError';
  }
}

class UnauthorizedError extends AppError {
  constructor(message = '未认证') {
    super(401, 'UNAUTHORIZED', message);
    this.name = 'UnauthorizedError';
  }
}

class ForbiddenError extends AppError {
  constructor(message = '无权限') {
    super(403, 'FORBIDDEN', message);
    this.name = 'ForbiddenError';
  }
}

class NotFoundError extends AppError {
  constructor(resource = '资源') {
    super(404, 'NOT_FOUND', \`\${resource} 未找到\`);
    this.name = 'NotFoundError';
  }
}

// ------------------------------------------------------------
// 第三部分：创建响应对象
// ------------------------------------------------------------

function createResponse(): MockResponse {
  const res: MockResponse = {
    statusCode: 200,
    headers: {},
    body: undefined,
    status(code: number) {
      this.statusCode = code;
      return this;
    },
    json(data: unknown) {
      this.headers['content-type'] = 'application/json';
      this.body = data;
    },
    send(data: string) {
      this.body = data;
    },
  };
  return res;
}

// ------------------------------------------------------------
// 第四部分：类型安全的中间件构建器
// ------------------------------------------------------------

// Logger 中间件类型：添加 requestId, startTime
interface RequestWithLogger {
  requestId: string;
  startTime: number;
}

function loggerMiddleware(): Middleware<MockRequest, MockRequest & RequestWithLogger> {
  return (req, _res, next) => {
    const reqWithLogger = req as MockRequest & RequestWithLogger;
    reqWithLogger.requestId = crypto.randomUUID();
    reqWithLogger.startTime = Date.now();
    console.log(\`[\${new Date().toISOString()}] [\${reqWithLogger.requestId}] \${req.method} \${req.path}\`);
    next();
  };
}

// Auth 中间件类型：添加 user
interface User {
  id: number;
  email: string;
  role: 'admin' | 'user';
}

interface RequestWithUser extends RequestWithLogger {
  user: User;
}

// 简化的认证中间件：检查 Authorization header
function authMiddleware(): Middleware<
  MockRequest & RequestWithLogger,
  MockRequest & RequestWithUser
> {
  return (req, _res, next) => {
    const authHeader = req.headers['authorization'];
    if (!authHeader || !authHeader.startsWith('Bearer ')) {
      return next(new UnauthorizedError('缺少或无效的 Authorization header'));
    }
    const token = authHeader.slice(7);
    // 模拟 JWT 解码：实际项目中应使用 jsonwebtoken 库
    // 这里用简单的 base64 解码模拟
    try {
      const decoded = JSON.parse(Buffer.from(token, 'base64').toString());
      const authReq = req as MockRequest & RequestWithUser;
      authReq.user = {
        id: decoded.id,
        email: decoded.email,
        role: decoded.role,
      };
      next();
    } catch {
      next(new UnauthorizedError('Token 解析失败'));
    }
  };
}

// 角色检查中间件工厂
function requireRole(requiredRole: 'admin' | 'user'): Middleware<MockRequest & RequestWithUser> {
  return (req, _res, next) => {
    if (req.user.role !== requiredRole) {
      return next(new ForbiddenError(\`需要 \${requiredRole} 角色\`));
    }
    next();
  };
}

// ------------------------------------------------------------
// 第五部分：Zod 风格的 Schema 验证
// ------------------------------------------------------------

interface Schema<T> {
  parse(data: unknown): T;
  safeParse(data: unknown): { success: true; data: T } | { success: false; error: { errors: Array<{ path: string[]; message: string }> } };
}

function createStringSchema(options?: { min?: number; max?: number; pattern?: RegExp }): Schema<string> {
  return {
    parse(data: unknown): string {
      const result = this.safeParse(data);
      if (!result.success) throw new ValidationError('验证失败', formatErrors(result.error.errors));
      return result.data;
    },
    safeParse(data: unknown) {
      if (typeof data !== 'string') {
        return { success: false, error: { errors: [{ path: [], message: '期望字符串类型' }] } };
      }
      if (options?.min !== undefined && data.length < options.min) {
        return { success: false, error: { errors: [{ path: [], message: \`最少 \${options.min} 个字符\` }] } };
      }
      if (options?.max !== undefined && data.length > options.max) {
        return { success: false, error: { errors: [{ path: [], message: \`最多 \${options.max} 个字符\` }] } };
      }
      if (options?.pattern && !options.pattern.test(data)) {
        return { success: false, error: { errors: [{ path: [], message: '格式不匹配' }] } };
      }
      return { success: true, data };
    },
  };
}

function createEmailSchema(): Schema<string> {
  const base = createStringSchema({ pattern: /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/ });
  return {
    parse: base.parse.bind(base),
    safeParse(data: unknown) {
      const strResult = base.safeParse(data);
      if (!strResult.success) return strResult;
      if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(strResult.data)) {
        return { success: false, error: { errors: [{ path: [], message: '邮箱格式不正确' }] } };
      }
      return { success: true, data: strResult.data };
    },
  };
}

function createNumberSchema(options?: { int?: boolean; min?: number; max?: number }): Schema<number> {
  return {
    parse(data: unknown): number {
      const result = this.safeParse(data);
      if (!result.success) throw new ValidationError('验证失败', formatErrors(result.error.errors));
      return result.data;
    },
    safeParse(data: unknown) {
      if (typeof data !== 'number' || isNaN(data)) {
        return { success: false, error: { errors: [{ path: [], message: '期望数字类型' }] } };
      }
      if (options?.int && !Number.isInteger(data)) {
        return { success: false, error: { errors: [{ path: [], message: '期望整数' }] } };
      }
      if (options?.min !== undefined && data < options.min) {
        return { success: false, error: { errors: [{ path: [], message: \`最小值 \${options.min}\` }] } };
      }
      if (options?.max !== undefined && data > options.max) {
        return { success: false, error: { errors: [{ path: [], message: \`最大值 \${options.max}\` }] } };
      }
      return { success: true, data };
    },
  };
}

function createObjectSchema<T extends Record<string, Schema<unknown>>>(
  shape: T
): Schema<{ [K in keyof T]: T[K] extends Schema<infer V> ? V : never }> {
  return {
    parse(data: unknown) {
      const result = this.safeParse(data);
      if (!result.success) throw new ValidationError('验证失败', formatErrors(result.error.errors));
      return result.data;
    },
    safeParse(data: unknown) {
      if (typeof data !== 'object' || data === null || Array.isArray(data)) {
        return { success: false, error: { errors: [{ path: [], message: '期望对象类型' }] } };
      }
      const obj = data as Record<string, unknown>;
      const result: Record<string, unknown> = {};
      const allErrors: Array<{ path: string[]; message: string }> = [];
      for (const key of Object.keys(shape)) {
        const fieldResult = shape[key].safeParse(obj[key]);
        if (fieldResult.success) {
          result[key] = fieldResult.data;
        } else {
          for (const err of fieldResult.error.errors) {
            allErrors.push({ path: [key, ...err.path], message: err.message });
          }
        }
      }
      if (allErrors.length > 0) {
        return { success: false, error: { errors: allErrors } };
      }
      return { success: true, data: result as { [K in keyof T]: T[K] extends Schema<infer V> ? V : never } };
    },
  };
}

function formatErrors(errors: Array<{ path: string[]; message: string }>): Record<string, string> {
  const result: Record<string, string> = {};
  for (const err of errors) {
    const key = err.path.length > 0 ? err.path.join('.') : '_error';
    result[key] = err.message;
  }
  return result;
}

// 验证中间件：验证请求体
function validateBody<T>(schema: Schema<T>): Middleware<MockRequest, MockRequest & { validatedBody: T }> {
  return (req, _res, next) => {
    const result = schema.safeParse(req.body);
    if (!result.success) {
      return next(new ValidationError('请求体验证失败', formatErrors(result.error.errors)));
    }
    const validatedReq = req as MockRequest & { validatedBody: T };
    validatedReq.validatedBody = result.data;
    next();
  };
}

// ------------------------------------------------------------
// 第六部分：类型安全的路由器
// ------------------------------------------------------------

interface RouteDefinition {
  method: HttpMethod;
  pathPattern: RegExp;
  paramNames: string[];
  handler: RouteHandler<any>;
  middlewares: Middleware<any, any>[];
}

class TypedRouter extends EventEmitter {
  private routes: RouteDefinition[] = [];
  private globalMiddlewares: Middleware<any, any>[] = [];
  private errorHandler?: (err: Error, req: MockRequest, res: MockResponse) => void;

  use<TIn = MockRequest, TOut extends TIn = TIn>(
    middleware: Middleware<TIn, TOut>
  ): TypedRouter {
    this.globalMiddlewares.push(middleware as Middleware<any, any>);
    return this;
  }

  setErrorHandler(handler: (err: Error, req: MockRequest, res: MockResponse) => void): this {
    this.errorHandler = handler;
    return this;
  }

  get<TReq extends MockRequest = MockRequest>(
    path: string,
    handler: RouteHandler<TReq>,
    ...middlewares: Middleware<any, any>[]
  ): this {
    this.addRoute('GET', path, handler, middlewares);
    return this;
  }

  post<TReq extends MockRequest = MockRequest>(
    path: string,
    handler: RouteHandler<TReq>,
    ...middlewares: Middleware<any, any>[]
  ): this {
    this.addRoute('POST', path, handler, middlewares);
    return this;
  }

  put<TReq extends MockRequest = MockRequest>(
    path: string,
    handler: RouteHandler<TReq>,
    ...middlewares: Middleware<any, any>[]
  ): this {
    this.addRoute('PUT', path, handler, middlewares);
    return this;
  }

  delete<TReq extends MockRequest = MockRequest>(
    path: string,
    handler: RouteHandler<TReq>,
    ...middlewares: Middleware<any, any>[]
  ): this {
    this.addRoute('DELETE', path, handler, middlewares);
    return this;
  }

  private addRoute(
    method: HttpMethod,
    path: string,
    handler: RouteHandler<any>,
    middlewares: Middleware<any, any>[]
  ): void {
    const { pattern, paramNames } = this.pathToRegex(path);
    this.routes.push({
      method,
      pathPattern: pattern,
      paramNames,
      handler,
      middlewares,
    });
  }

  private pathToRegex(path: string): { pattern: RegExp; paramNames: string[] } {
    const paramNames: string[] = [];
    const regexPath = path.replace(/:([\\w]+)/g, (_, name) => {
      paramNames.push(name);
      return '([^/]+)';
    });
    return { pattern: new RegExp(\`^\${regexPath}$\`), paramNames };
  }

  // 模拟处理请求（不实际启动 HTTP 服务器）
  async handleRequest(
    method: HttpMethod,
    path: string,
    options: {
      headers?: Record<string, string>;
      body?: unknown;
      query?: Record<string, unknown>;
    } = {}
  ): Promise<MockResponse> {
    const req: MockRequest = {
      method,
      path,
      headers: options.headers || {},
      body: options.body || {},
      query: options.query || {},
      params: {},
    };
    const res = createResponse();

    try {
      // 查找匹配的路由
      const route = this.findRoute(method, path);
      if (!route) {
        throw new NotFoundError(\`路由 \${method} \${path}\`);
      }

      // 提取路由参数
      const params: Record<string, string> = {};
      const match = path.match(route.pathPattern);
      if (match) {
        route.paramNames.forEach((name, i) => {
          params[name] = match[i + 1];
        });
      }
      req.params = params;

      // 构建完整的中间件链：全局中间件 + 路由级中间件 + 处理器
      const allMiddlewares = [
        ...this.globalMiddlewares,
        ...route.middlewares,
      ];

      // 执行中间件链
      await this.executeMiddlewares(req, res, allMiddlewares);

      if (res.body === undefined) {
        // 执行路由处理器
        await route.handler(req, res);
      }
    } catch (err) {
      if (this.errorHandler) {
        this.errorHandler(err as Error, req, res);
      } else {
        res.statusCode = 500;
        res.json({ error: '内部服务器错误', message: (err as Error).message });
      }
    }

    const duration = (req as any).startTime ? Date.now() - (req as any).startTime : 0;
    console.log(\`  -> 响应 \${res.statusCode} (\${duration}ms)\`);
    return res;
  }

  private findRoute(method: HttpMethod, path: string): RouteDefinition | null {
    for (const route of this.routes) {
      if (route.method === method && route.pathPattern.test(path)) {
        return route;
      }
    }
    return null;
  }

  private async executeMiddlewares(
    req: MockRequest,
    res: MockResponse,
    middlewares: Middleware<any, any>[]
  ): Promise<void> {
    let index = 0;

    const next: NextFunction = async (err?: Error) => {
      if (err) throw err;
      if (index < middlewares.length) {
        const middleware = middlewares[index++];
        const result = await middleware(req, res, next);
        if (result && typeof result === 'object') {
          Object.assign(req, result);
        }
      }
    };

    await next();
  }

  listRoutes(): void {
    console.log('\\n=== 已注册路由 ===');
    for (const route of this.routes) {
      console.log(\`  \${route.method.padEnd(6)} \${route.pathPattern.source.replace(/\\\\\\^\\\\\\\//g, '/').replace(/\\\\\\$/, '').replace(/\\\\\\(\\[\\^\\\\\\/\\]\\+\\)\\)/g, ':param')}\`);
    }
    console.log('==================\\n');
  }
}

// ------------------------------------------------------------
// 第七部分：示例：构建一个博客 API
// ------------------------------------------------------------

console.log('========================================');
console.log('  类型安全 Web 框架演示');
console.log('========================================\\n');

// 创建路由器实例
const app = new TypedRouter();

// 注册全局中间件
app.use(loggerMiddleware());

// 设置全局错误处理器
app.setErrorHandler((err, _req, res) => {
  if (err instanceof AppError) {
    res.status(err.statusCode);
    res.json({
      error: err.code,
      message: err.message,
      details: err.details,
    });
  } else {
    console.error('未捕获的错误:', err);
    res.status(500);
    res.json({ error: 'INTERNAL_ERROR', message: '内部服务器错误' });
  }
});

// 模拟数据库
interface Post {
  id: number;
  title: string;
  content: string;
  authorId: number;
  createdAt: string;
}

const posts: Post[] = [
  { id: 1, title: 'TypeScript 入门', content: 'TypeScript 是 JavaScript 的超集...', authorId: 1, createdAt: '2026-01-01' },
  { id: 2, title: 'Node.js 后端开发', content: 'Node.js 让 JavaScript 可以运行在服务端...', authorId: 1, createdAt: '2026-01-15' },
];

// 定义验证 Schema
const CreatePostSchema = createObjectSchema({
  title: createStringSchema({ min: 1, max: 100 }),
  content: createStringSchema({ min: 1, max: 10000 }),
});

const UpdatePostSchema = createObjectSchema({
  title: createStringSchema({ min: 1, max: 100 }),
  content: createStringSchema({ min: 1, max: 10000 }),
});

// 注册路由
// 公开路由：获取文章列表
app.get('/api/posts', (req, res) => {
  const page = parseInt((req.query as any).page || '1', 10);
  const pageSize = parseInt((req.query as any).pageSize || '10', 10);
  const start = (page - 1) * pageSize;
  const pagedPosts = posts.slice(start, start + pageSize);
  res.json({
    success: true,
    data: pagedPosts,
    pagination: {
      page,
      pageSize,
      total: posts.length,
      totalPages: Math.ceil(posts.length / pageSize),
    },
  });
});

// 公开路由：获取单篇文章
app.get('/api/posts/:id', (req, res) => {
  const id = parseInt(req.params.id, 10);
  const post = posts.find(p => p.id === id);
  if (!post) {
    throw new NotFoundError('文章');
  }
  res.json({ success: true, data: post });
});

// 需要认证的路由：创建文章
app.post<MockRequest & RequestWithUser & { validatedBody: { title: string; content: string } }>(
  '/api/posts',
  (req, res) => {
    // 这里 req.user 和 req.validatedBody 都是类型安全的！
    const { title, content } = req.validatedBody;
    const newPost: Post = {
      id: posts.length + 1,
      title,
      content,
      authorId: req.user.id,
      createdAt: new Date().toISOString().split('T')[0],
    };
    posts.push(newPost);
    res.status(201);
    res.json({ success: true, data: newPost });
  },
  authMiddleware(),
  validateBody(CreatePostSchema),
);

// 需要认证和管理员权限的路由：删除文章
app.delete(
  '/api/posts/:id',
  (req, res) => {
    const id = parseInt(req.params.id, 10);
    const index = posts.findIndex(p => p.id === id);
    if (index === -1) {
      throw new NotFoundError('文章');
    }
    const deleted = posts.splice(index, 1)[0];
    res.json({ success: true, data: deleted });
  },
  authMiddleware(),
  requireRole('admin'),
);

// 列出所有路由
app.listRoutes();

// ------------------------------------------------------------
// 第八部分：模拟请求测试
// ------------------------------------------------------------

async function runTests() {
  console.log('--- 测试 1: 获取文章列表（公开访问）---');
  const res1 = await app.handleRequest('GET', '/api/posts', { query: { page: '1', pageSize: '10' } });
  console.log('响应体:', JSON.stringify(res1.body, null, 2));

  console.log('\\n--- 测试 2: 获取单篇文章 ---');
  const res2 = await app.handleRequest('GET', '/api/posts/1');
  console.log('响应体:', JSON.stringify(res2.body, null, 2));

  console.log('\\n--- 测试 3: 访问不存在的路由 ---');
  const res3 = await app.handleRequest('GET', '/api/unknown');
  console.log('状态码:', res3.statusCode);
  console.log('响应体:', JSON.stringify(res3.body, null, 2));

  console.log('\\n--- 测试 4: 创建文章（未认证 - 应失败）---');
  const res4 = await app.handleRequest('POST', '/api/posts', {
    headers: { 'content-type': 'application/json' },
    body: { title: '新文章', content: '文章内容' },
  });
  console.log('状态码:', res4.statusCode);
  console.log('响应体:', JSON.stringify(res4.body, null, 2));

  // 创建一个模拟的有效 token（base64 编码的用户信息）
  const validUserToken = Buffer.from(JSON.stringify({
    id: 1,
    email: 'user@example.com',
    role: 'user',
  })).toString('base64');

  const adminToken = Buffer.from(JSON.stringify({
    id: 2,
    email: 'admin@example.com',
    role: 'admin',
  })).toString('base64');

  console.log('\\n--- 测试 5: 创建文章（已认证普通用户 - 应成功）---');
  const res5 = await app.handleRequest('POST', '/api/posts', {
    headers: {
      'content-type': 'application/json',
      'authorization': \`Bearer \${validUserToken}\`,
    },
    body: { title: '我的新文章', content: '这是文章的正文内容...' },
  });
  console.log('状态码:', res5.statusCode);
  console.log('响应体:', JSON.stringify(res5.body, null, 2));

  console.log('\\n--- 测试 6: 创建文章（标题为空 - 验证失败）---');
  const res6 = await app.handleRequest('POST', '/api/posts', {
    headers: {
      'content-type': 'application/json',
      'authorization': \`Bearer \${validUserToken}\`,
    },
    body: { title: '', content: '这是文章内容' },
  });
  console.log('状态码:', res6.statusCode);
  console.log('响应体:', JSON.stringify(res6.body, null, 2));

  console.log('\\n--- 测试 7: 删除文章（普通用户 - 权限不足）---');
  const res7 = await app.handleRequest('DELETE', '/api/posts/1', {
    headers: { 'authorization': \`Bearer \${validUserToken}\` },
  });
  console.log('状态码:', res7.statusCode);
  console.log('响应体:', JSON.stringify(res7.body, null, 2));

  console.log('\\n--- 测试 8: 删除文章（管理员 - 应成功）---');
  const res8 = await app.handleRequest('DELETE', '/api/posts/2', {
    headers: { 'authorization': \`Bearer \${adminToken}\` },
  });
  console.log('状态码:', res8.statusCode);
  console.log('响应体:', JSON.stringify(res8.body, null, 2));

  console.log('\\n--- 测试 9: 获取不存在的文章 ---');
  const res9 = await app.handleRequest('GET', '/api/posts/999');
  console.log('状态码:', res9.statusCode);
  console.log('响应体:', JSON.stringify(res9.body, null, 2));

  console.log('\\n========================================');
  console.log('  所有测试演示完成！');
  console.log('========================================');
}

runTests().catch(console.error);
`,
